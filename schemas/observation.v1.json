{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://counter-swarm.local/schemas/observation.v1.json",
  "title": "CanonicalObservation",
  "description": "Author: Victor.I — Stage 0 draft canonical observation. Normative for adapters after approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id",
    "schema_version",
    "sensor_id",
    "source_type",
    "timestamp_utc",
    "received_at_utc",
    "location",
    "measurement",
    "confidence",
    "provenance"
  ],
  "properties": {
    "observation_id": { "type": "string", "format": "uuid" },
    "schema_version": { "type": "string", "const": "1.0.0" },
    "sensor_id": { "type": "string", "minLength": 1 },
    "source_type": {
      "type": "string",
      "enum": ["radar", "eo", "ir", "rf", "acoustic", "telemetry", "other", "sim"]
    },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "received_at_utc": { "type": "string", "format": "date-time" },
    "idempotency_key": { "type": "string" },
    "location": {
      "type": "object",
      "required": ["crs"],
      "properties": {
        "crs": { "type": "string", "default": "EPSG:4326" },
        "lat": { "type": ["number", "null"] },
        "lon": { "type": ["number", "null"] },
        "alt_m": { "type": ["number", "null"] },
        "uncertainty": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "measurement": { "type": "object", "additionalProperties": true },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "quality": { "type": "object", "additionalProperties": true },
    "provenance": {
      "type": "object",
      "required": ["adapter", "adapter_version"],
      "properties": {
        "adapter": { "type": "string" },
        "adapter_version": { "type": "string" },
        "raw_ref": { "type": "string" }
      },
      "additionalProperties": false
    },
    "metadata": { "type": "object", "additionalProperties": true }
  }
}
